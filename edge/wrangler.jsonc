{
  // The live Worker was created in the Cloudflare dashboard. This file describes the
  // same setup for `npx wrangler deploy --config edge/wrangler.jsonc`.
  "name": "fitovela-edge",
  "main": "worker.js",
  "compatibility_date": "2026-08-24",
  "preview_urls": false,
  // Request logs are off on purpose: a plan link is a private credential and must not be stored in logs.
  "observability": { "enabled": false },
  "routes": [
    { "pattern": "fitovela.com", "custom_domain": true },
    { "pattern": "www.fitovela.com", "custom_domain": true }
  ]
}
